<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_beige"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        android:paddingTop="20dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/name_of_store"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beedle's Shop"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/dark_brown"
                android:layout_margin="20dp"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@+id/cart"
                android:layout_width="50dp"
                android:layout_centerVertical="true"
                android:layout_height="50dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:src="@drawable/chest_for_cart"
                />
            <ImageView
                android:id="@+id/amount_goods"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="13dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_for_cart"
                android:layout_alignTop="@id/cart"
                android:layout_alignRight="@id/cart"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/dark_brown"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_marginRight="8dp"
                android:layout_marginTop="2dp"
                android:layout_alignTop="@id/amount_goods"
                android:layout_alignRight="@id/amount_goods"/>
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/dark_brown" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/dark_brown"
            android:layout_marginTop="2dp"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>